# =========================================================
# Copiá este archivo como .env y completá los valores.
# Nunca subas el .env real al repositorio.
# =========================================================

# Servidor
PORT=4000
HOST=127.0.0.1
FLASK_DEBUG=1

# MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crm_artes_marciales

# MySQL en la nube: DB_SSL=1 (y el CA si el proveedor lo pide)
DB_SSL=0
# DB_SSL_CA=/ruta/al/ca.pem
# DB_SSL_VERIFY=0

# Clave larga y aleatoria para firmar los JWT
JWT_SECRET=cambiame-por-una-clave-larga-y-aleatoria

# Cloudinary (fotos de perfil)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google (opcional)
GOOGLE_CLIENT_ID=
# 1 = crea un alumno provisorio al entrar con Google
# 0 = solo permite cuentas que ya existen en el CRM
GOOGLE_AUTO_ALTA=1

# Si el frontend está en otro dominio, limitar CORS acá
# (varios separados por coma). Si Flask sirve el frontend, dejar vacío.
# CORS_ORIGINS=https://mi-frontend.netlify.app
